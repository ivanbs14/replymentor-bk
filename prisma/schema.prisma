generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

enum QuestionDetectionStatus {
  DETECTED
  NOT_FOUND
}

enum QuestionDetectionSource {
  LEGACY
  DETERMINISTIC
  LLM
  MANUAL
}

enum SessionSummaryStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model InterviewContext {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeText         String
  interviewType      String
  jobLevel           String
  jobDescription     String
  companyName        String
  companySegment     String?
  responsePreference String
  aiBehavior         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  sessions           InterviewSession[]
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  contexts     InterviewContext[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model InterviewSession {
  id                     String              @id @default(cuid())
  status                 SessionStatus       @default(ACTIVE)
  nextTranscriptSequence Int                 @default(1)
  startedAt              DateTime            @default(now())
  endedAt                DateTime?
  contextId              String
  context                InterviewContext    @relation(fields: [contextId], references: [id], onDelete: Cascade)
  transcripts            TranscriptChunk[]
  questionDetections     QuestionDetection[]
  suggestedResponse      SuggestedResponse[]
  summary                SessionSummary?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model TranscriptChunk {
  id                 String           @id @default(cuid())
  sessionId          String
  session            InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence           Int
  content            String
  source             String           @default("stt")
  idempotencyKey     String?
  requestFingerprint String?
  createdAt          DateTime         @default(now())

  @@unique([sessionId, sequence])
}

model QuestionDetection {
  id                 String                  @id @default(cuid())
  sessionId          String
  session            InterviewSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status             QuestionDetectionStatus
  question           String?
  confidence         Float?
  source             QuestionDetectionSource
  detectorVersion    String
  evidence           Json
  provider           String?
  model              String?
  idempotencyKey     String?
  requestFingerprint String?
  response           SuggestedResponse?
  createdAt          DateTime                @default(now())

  @@unique([sessionId, id])
}

model SuggestedResponse {
  id                 String            @id @default(cuid())
  sessionId          String
  session            InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  detectedQuestion   String
  suggestedAnswer    String
  shortVersion       String
  keyPoints          String[]
  strategicNote      String
  idempotencyKey     String?
  requestFingerprint String?
  detectionId        String            @unique
  detection          QuestionDetection @relation(fields: [sessionId, detectionId], references: [sessionId, id], onDelete: Restrict, map: "SuggestedResponse_detectionId_fkey")
  createdAt          DateTime          @default(now())

  @@unique([sessionId, detectionId])
}

model SessionSummary {
  id                    String               @id @default(cuid())
  sessionId             String               @unique
  session               InterviewSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status                SessionSummaryStatus @default(PENDING)
  content               Json?
  fallbackContent       String
  provider              String?
  model                 String?
  promptVersion         String               @default("session-summary-v1")
  startedAt             DateTime?
  claimedAt             DateTime?
  providerCallStartedAt DateTime?
  completedAt           DateTime?
  errorCode             String?
  attemptCount          Int                  @default(0)
  manualRetryUsed       Boolean              @default(false)
  evidenceResponseIds   String[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status, claimedAt])
}
