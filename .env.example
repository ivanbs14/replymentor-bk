# Produção desta configuração: URL pooled do Neon, sempre como secret.
DATABASE_URL="postgresql://user:password@host-pooler.us-east-1.aws.neon.tech/database?sslmode=require"
DATABASE_URL_TEST="postgresql://replymentor_test:replymentor_test@localhost:55432/replymentor_test?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ISSUER="replymentor-api"
JWT_AUDIENCE="replymentor-web"
CORS_ORIGINS="http://localhost:3000"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_ALLOWED_MODELS="gemini-2.0-flash"
QUESTION_DETECTION_MODEL="gemini-2.0-flash"
QUESTION_DETECTION_TIMEOUT_MS="1500"
QUESTION_DETECTION_ALLOWED_MODELS="gemini-2.0-flash"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_ALLOWED_MODELS="gpt-4.1-mini"
OLLAMA_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_ALLOWED_MODELS="llama3.2:3b"
LLM_TIMEOUT_MS="90000"
WHISPER_BASE_URL="http://localhost:8000"
WHISPER_MODEL="Systran/faster-whisper-large-v3"
WHISPER_API_KEY=""
STT_TIMEOUT_MS="60000"
PORT="3001"

# Redis é obrigatório fora de testes unitários.
# Render Key Value fornece esta URL por referência privada no Blueprint.
REDIS_URL="redis://localhost:6379"
# Gere um segredo próprio, diferente do JWT; este placeholder é rejeitado.
# Processos locais distribuídos também precisam compartilhar o mesmo segredo.
RATE_LIMIT_KEY_SECRET="replace-with-at-least-32-random-characters"
# Em Render, habilita CF-Connecting-IP validado e mantém trust proxy em zero.
# DEPLOY_PROVIDER="render"
# Fora do Render, configure a quantidade exata de proxies confiáveis.
TRUST_PROXY_HOPS="0"
# RATE_LIMITS_JSON='{"auth_login_ip":[{"limit":10,"windowSeconds":60}]}'
